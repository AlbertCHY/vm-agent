# ─── Gemini (Supervisor 與 VM Provisioning 子圖) ───
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.8-flash

# ─── VMware Aria Automation ───
AUTOMATION_URL=https://your-aria-automation.example.com
AUTOMATION_API_TOKEN=your-refresh-token
AUTOMATION_VERIFY_SSL=false
# AUTOMATION_HTTP_TIMEOUT=15

# ─── 本地 Ollama (工單解析) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
# OLLAMA_TIMEOUT=300
# OLLAMA_NUM_CTX=8192
# OLLAMA_MAX_RAW_CHARS=6000

# ─── SSH (VM 磁碟診斷) ───
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
DEFAULT_SSH_USER=root
# SSH_KEY_PASSPHRASE=
# SSH_PORT=22
# SSH_TIMEOUT=10
# true = 只連線 known_hosts 已存在的主機
# SSH_STRICT_HOST_KEY=false

# ─── 工單資料夾 (相對路徑以專案根目錄為基準) ───
# TICKETS_DIR=./tickets
